; Register size helpers: keep the assembler's idea of A/X size in step.
.MACRO A8
  sep #$20
  .ACCU 8
.ENDM
.MACRO A16
  rep #$20
  .ACCU 16
.ENDM
.MACRO XY8
  sep #$10
  .INDEX 8
.ENDM
.MACRO XY16
  rep #$10
  .INDEX 16
.ENDM
.MACRO AXY16
  rep #$30
  .ACCU 16
  .INDEX 16
.ENDM
